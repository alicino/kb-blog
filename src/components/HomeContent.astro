---
import type { Paginated } from '../lib/paginate';
import type { Article } from '../lib/articles';
import ArticleCard from './ArticleCard.astro';
import Pagination from './Pagination.astro';
import { siteConfig } from '../site.config';
import { t, type Locale } from '../lib/i18n';

interface Props {
  page: Paginated<Article>;
  lang?: Locale;
}

const { page, lang = 'pt-br' } = Astro.props;
const dict = t(lang);
const isFirstPage = page.currentPage === 1;
const homeHref = lang === 'en' ? '/en' : '/';
const pagePathPrefix = lang === 'en' ? '/en/page' : '';
---

{
  isFirstPage ? (
    <section class="home-intro">
      <h1 class="visually-hidden">{siteConfig.name}</h1>
      <p class="home-headline">
        <strong>{dict.home.heroBold}</strong>
        <br />
        <em>{dict.home.heroItalic}</em>
      </p>
      <p class="home-intro-text">{dict.home.heroTagline}</p>
    </section>
  ) : (
    <h1 class="visually-hidden">
      {siteConfig.name}{dict.home.pageSuffix(page.currentPage)}
    </h1>
  )
}

<section aria-label={dict.home.recentArticles}>
  <h2 class="visually-hidden">{dict.home.recentArticles}</h2>
  <div class="home-grid">
    {page.data.map((article) => <ArticleCard article={article} lang={lang} />)}
  </div>

  <Pagination page={page} firstPageHref={homeHref} pagePathPrefix={pagePathPrefix} lang={lang} />
</section>

<section class="home-editorial">
  <svg
    class="home-editorial-decor"
    aria-hidden="true"
    viewBox="0 0 400 400"
    xmlns="http://www.w3.org/2000/svg"
  >
    <ellipse
      cx="230"
      cy="170"
      rx="150"
      ry="60"
      stroke="currentColor"
      stroke-width="1.5"
      fill="none"
      transform="rotate(-18 230 170)"
    />
    <ellipse
      cx="230"
      cy="170"
      rx="150"
      ry="60"
      stroke="currentColor"
      stroke-width="1"
      fill="none"
      stroke-dasharray="2 8"
      transform="rotate(34 230 170)"
    />
    <circle cx="352" cy="140" r="5" fill="currentColor" />
    <circle cx="130" cy="214" r="3.5" fill="currentColor" />
    <text
      class="home-editorial-decor-mark"
      x="196"
      y="255"
      font-size="230"
      fill="currentColor"
      text-anchor="middle"
    >
      ?
    </text>
  </svg>

  <h2>{dict.home.editorialTitle}</h2>

  <div class="home-editorial-body">
    {dict.home.editorialParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .home-intro {
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }

  .home-headline {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.9rem + 2vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: var(--space-3) 0 0;
  }

  .home-headline strong {
    font-weight: 700;
  }

  .home-headline em {
    font-style: italic;
    font-weight: 600;
    color: var(--color-accent-strong);
  }

  .home-intro-text {
    font-family: var(--font-ui);
    font-size: clamp(1rem, 0.94rem + 0.25vw, 1.1rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 46ch;
    margin: var(--space-5) 0 0;
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 900px) {
    .home-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }

  .home-editorial {
    position: relative;
    overflow: hidden;
    max-width: none;
    margin: var(--space-8) 0 0;
    padding: var(--space-8) var(--space-7);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .home-editorial-decor {
    position: absolute;
    top: -8%;
    right: -6%;
    width: 60%;
    max-width: 420px;
    height: auto;
    color: var(--color-accent);
    opacity: 0.16;
    pointer-events: none;
  }

  .home-editorial-decor-mark {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .home-editorial h2 {
    position: relative;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.9rem, 1.55rem + 1.4vw, 2.6rem);
    line-height: 1.15;
    color: var(--color-accent-strong);
    max-width: 20ch;
    margin: 0 0 var(--space-6);
  }

  .home-editorial-body {
    position: relative;
    max-width: 66ch;
  }

  .home-editorial-body p {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .home-editorial {
      padding: var(--space-6) var(--space-5);
    }

    .home-editorial-decor {
      width: 80%;
      opacity: 0.12;
    }
  }
</style>
