---
import type { Article } from '../lib/articles';
import { articleHref, categoryHref, formatDate } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const href = articleHref(article);
---

<article class="article-row">
  <div class="article-row-main">
    <p class="eyebrow">
      <a href={categoryHref(article.data.category)}>{article.data.category}</a>
    </p>
    <h2 class="article-row-title"><a href={href}>{article.data.title}</a></h2>
    <p class="article-row-desc">{article.data.description}</p>
  </div>
  <time class="meta article-row-date" datetime={article.data.publishDate.toISOString()}>
    {formatDate(article.data.publishDate)}
  </time>
</article>

<style>
  .article-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .article-row:last-child {
    border-bottom: none;
  }

  .article-row-main {
    min-width: 0;
  }

  .article-row-title {
    font-size: 1.2rem;
    margin: var(--space-1) 0 var(--space-2);
  }

  .article-row-title a {
    color: inherit;
    text-decoration: none;
  }

  .article-row-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-row-title a:hover {
    color: var(--color-accent-strong);
  }

  .article-row-desc {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .article-row-date {
    flex-shrink: 0;
    white-space: nowrap;
    padding-top: var(--space-1);
  }

  .eyebrow a {
    position: relative;
    z-index: 2;
    text-decoration: none;
  }

  .eyebrow a:hover {
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .article-row {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
