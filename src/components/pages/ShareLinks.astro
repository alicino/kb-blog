---
/**
 * PROTOTIPO DE TESTE (Fase 1): barra de compartilhar artigo.
 * Server-rendered: as ancora funcionam sem JavaScript. O script apenas
 * adiciona os aprimoramentos progressivos (copiar link e share nativo).
 */
import { t, type Locale } from '../../lib/i18n';

interface Props {
  url: string;
  title: string;
  locale: Locale;
}

const { url, title, locale } = Astro.props;
const dict = t(locale);
const enc = encodeURIComponent;
const text = `${title} ${url}`;

const targets = [
  { id: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/?text=${enc(text)}` },
  {
    id: 'telegram',
    label: 'Telegram',
    href: `https://t.me/share/url?url=${enc(url)}&text=${enc(title)}`,
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
  },
  { id: 'x', label: 'X', href: `https://x.com/intent/post?url=${enc(url)}&text=${enc(title)}` },
  { id: 'email', label: 'Email', href: `mailto:?subject=${enc(title)}&body=${enc(url)}` },
];

// Paths verificados visualmente (Simple Icons CC0 + envelope/elo/glyph proprios).
const ICONS: Record<string, string> = {
  whatsapp:
    '<path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.791-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>',
  telegram:
    '<path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>',
  linkedin:
    '<path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  x: '<path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>',
  email:
    '<path fill="currentColor" d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6zm2.4-.5 7.6 5.2 7.6-5.2H4.4zm16.1 2.6-8.5 5.8-8.5-5.8V18h17V8.1z"/>',
  copy: '<path fill="currentColor" d="M10.59 13.41a1 1 0 0 1 0-1.41l3.41-3.41a3 3 0 1 1 4.24 4.24l-1.41 1.42a1 1 0 1 1-1.42-1.42l1.42-1.41a1 1 0 1 0-1.42-1.41l-3.41 3.4a1 1 0 0 1-1.41 0zm2.82-2.82a1 1 0 0 1 0 1.41L10 15.41a3 3 0 1 1-4.24-4.24l1.41-1.41a1 1 0 1 1 1.42 1.41l-1.42 1.41a1 1 0 1 0 1.42 1.41l3.41-3.4a1 1 0 0 1 1.41 0z"/>',
  native:
    '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v13"/>',
};
---

<nav class="share" aria-label={dict.article.share} data-share-url={url}>
  <span class="share-label">{dict.article.share}</span>
  <ul class="share-links">
    {
      targets.map((s) => (
        <li>
          <a
            class="share-btn"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            data-share-target={s.id}
          >
            <svg class="share-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <Fragment set:html={ICONS[s.id]} />
            </svg>
            {s.label}
          </a>
        </li>
      ))
    }
    <li>
      <button class="share-btn" type="button" data-share-copy data-share-copied={dict.article.shareCopied} hidden>
        <svg class="share-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <Fragment set:html={ICONS.copy} />
        </svg>
        {dict.article.shareCopy}
      </button>
    </li>
  </ul>
  <button class="share-btn share-btn-native" type="button" data-share-native hidden>
    <svg class="share-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <Fragment set:html={ICONS.native} />
    </svg>
    {dict.article.shareNative}
  </button>
</nav>

<script>
  // Aprimoramento progressivo: revela os botes que dependem de JS e liga as aes.
  const nav = document.querySelector('[data-share-url]');
  if (nav) {
    const url = nav.getAttribute('data-share-url') ?? '';
    const copyBtn = nav.querySelector<HTMLElement>('[data-share-copy]');
    const nativeBtn = nav.querySelector<HTMLElement>('[data-share-native]');

    if (copyBtn) {
      copyBtn.hidden = false;
      copyBtn.addEventListener('click', async () => {
        const original = copyBtn.textContent;
        try {
          await navigator.clipboard.writeText(url);
          copyBtn.classList.add('is-copied');
          copyBtn.textContent = copyBtn.getAttribute('data-share-copied') ?? 'OK';
        } catch {
          // Sem clipboard API: mantm o rtulo original (usurio ainda tem o link na barra).
        }
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          copyBtn.textContent = original;
        }, 2000);
      });
    }

    if (nativeBtn && 'share' in navigator) {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => navigator.share({ title: document.title, url }));
    }
  }
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    max-width: 90ch;
    margin: 0 auto var(--space-6);
    font-family: var(--font-ui);
  }

  .share-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-right: var(--space-1);
  }

  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    text-decoration: none;
    cursor: pointer;
  }

  .share-icon {
    flex: none;
  }

  .share-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    background: var(--color-surface-muted);
  }

  .share-btn.is-copied {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    background: var(--color-surface-muted);
  }

  .share-btn-native {
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .share-btn-native {
      margin-left: 0;
    }
  }
</style>
