---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { getCategories, categoryHref } from '../../lib/articles';
import { siteConfig } from '../../site.config';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'pt-br' } = Astro.props;
const dict = t(lang);
const categories = await getCategories(lang);
const homeHref = lang === 'en' ? '/en' : '/';

const alternateUrls = { 'pt-br': '/categorias', en: '/en/categories' };
---

<BaseLayout
  title={dict.categories.title}
  description={`${dict.categories.title} · ${siteConfig.name}`}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <div class="page-shell">
    <div class="surface surface-inner">
      <div class="section-content">
        <Breadcrumbs
          lang={lang}
          items={[{ label: dict.article.breadcrumbHome, href: homeHref }, { label: dict.categories.title }]}
        />
        <h1>{dict.categories.title}</h1>
        <p class="meta categories-count">{dict.categories.countLabel(categories.length)}</p>

        <ul class="category-list">
          {
            categories.map((category) => (
              <li class="category-item">
                <a class="category-link" href={categoryHref(category.name, lang)}>
                  <h2 class="category-name">{category.displayName}</h2>
                  <p class="category-desc">{category.description}</p>
                  <p class="meta">{dict.tag.countLabel(category.count)}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .categories-count {
    margin-top: calc(var(--space-2) * -1);
    margin-bottom: var(--space-6);
  }

  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .category-item {
    position: relative;
  }

  .category-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    height: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .category-link:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-card);
  }

  .category-name {
    font-size: 1.1rem;
    margin-bottom: var(--space-2);
  }

  .category-desc {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  @media (max-width: 640px) {
    .category-list {
      grid-template-columns: 1fr;
    }
  }
</style>
