---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { siteConfig } from '../../site.config';
import linkGroups from '../../data/links.json';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'pt-br' } = Astro.props;
const dict = t(lang);
const homeHref = lang === 'en' ? '/en' : '/';
const description =
  lang === 'en'
    ? `Links recommended by ${siteConfig.author.name}.`
    : `Links recomendados por ${siteConfig.author.name}.`;

const alternateUrls = { 'pt-br': '/links', en: '/en/links' };
---

<BaseLayout title={dict.nav.links} description={description} lang={lang} alternateUrls={alternateUrls}>
  <div class="page-shell">
    <div class="surface surface-inner">
      <div class="section-content">
        <Breadcrumbs lang={lang} items={[{ label: dict.article.breadcrumbHome, href: homeHref }, { label: dict.nav.links }]} />
        <h1>{lang === 'en' ? 'Recommended links' : 'Links recomendados'}</h1>
        <p class="links-intro meta">
          {lang === 'en'
            ? 'A selection of sites and resources I use or check often, organized by topic. (Some link descriptions below are still in Portuguese — full translation is planned.)'
            : 'Uma seleção de sites e recursos que uso ou consulto com frequência, organizados por tema.'}
        </p>

        {
          linkGroups.map((group) => (
            <section class="link-group">
              <h2>{group.group}</h2>
              <ul class="link-list">
                {group.links.map((link) => (
                  <li class="link-item">
                    <a
                      class="link-item-title"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                      <svg
                        class="external-icon"
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M7 17 17 7M9 7h8v8"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span class="visually-hidden">(abre em nova aba)</span>
                    </a>
                    <p class="link-item-desc">{link.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .links-intro {
    margin-bottom: var(--space-7);
    max-width: 60ch;
  }

  .link-group {
    margin-bottom: var(--space-7);
  }

  .link-group:last-child {
    margin-bottom: 0;
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .link-item:last-child {
    border-bottom: none;
  }

  .link-item-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .link-item-title:hover {
    color: var(--color-accent-strong);
  }

  .external-icon {
    color: var(--color-text-faint);
  }

  .link-item-desc {
    margin: var(--space-1) 0 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
