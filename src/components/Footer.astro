  github: 'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.92c-2.78.62-3.37-1.36-3.37-1.36-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.34 1.12 2.91.85.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.95.68 1.92v2.85c0 .27.18.6.69.49A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z',
  twitter: 'M20 6.4c-.63.29-1.3.48-2 .57a3.5 3.5 0 0 0 1.53-1.93 6.9 6.9 0 0 1-2.2.85 3.47 3.47 0 0 0-5.9 3.16A9.83 9.83 0 0 1 4.2 5.6a3.47 3.47 0 0 0 1.07 4.63c-.56-.02-1.09-.17-1.55-.43v.04a3.47 3.47 0 0 0 2.78 3.4c-.5.14-1.04.16-1.55.06a3.48 3.48 0 0 0 3.24 2.41A6.96 6.96 0 0 1 3 17.13a9.8 9.8 0 0 0 5.32 1.56c6.38 0 9.87-5.29 9.87-9.87l-.01-.45A7.06 7.06 0 0 0 20 6.4Z',
  linkedin: 'M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 20h-3.37v-5.9c0-1.4-.03-3.2-1.95-3.2-1.96 0-2.26 1.53-2.26 3.1V20H9.5V8.5h3.24v1.57h.05c.45-.86 1.56-1.77 3.21-1.77 3.43 0 4.07 2.26 4.07 5.2V20Z',
  mastodon: 'M12 2C6.9 2 4 3.4 4 3.4v9.7c0 4.7 3.6 6.7 8 6.7 1 0 1.9-.1 2.7-.3v-2.6c-.7.2-1.5.3-2.5.3-2.9 0-5-1-5-3.6V13c1.1.6 2.6.9 4.8.9 4.4 0 7-2 7-6.7 0-2.6-1.8-4.2-6-4.2Zm2.6 6.7c0 1.4-.7 2.1-2 2.1-1.4 0-2.1-.7-2.1-2.1V7.6c0-1.4.7-2.1 2.1-2.1 1.3 0 2 .7 2 2.1v1.1Z',
  rss: 'M4 4a16 16 0 0 1 16 16h-3a13 13 0 0 0-13-13V4ZM4 10a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7v-3Zm2 10a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z',
  email: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1.4 2 7.1 6.1a1 1 0 0 0 1 0L19.6 7H4.4ZM4 8.5V18h16V8.5l-6.9 5.9a3 3 0 0 1-3 0L4 8.5Z',
};
---

<footer class="footer-wrap">
  <div class="page-shell footer-shell">
    <div class="footer surface surface-inner">
      <div class="footer-brand">
        <Logo size="sm" />
        <p class="meta">
          © {yearLabel} {siteConfig.author.name}. Todos os direitos reservados.
        </p>
      </div>

      <nav class="footer-links" aria-label="Links do rodapé">
        {
          siteConfig.footerLinks.map((link) => (
            <a href={link.url}>{link.label}</a>
          ))
        }
      </nav>

      <div class="footer-socials" aria-label="Redes sociais">
        {
          siteConfig.socials.map((social) => (
            <a href={social.url} aria-label={social.label} title={social.label} target={social.url.startsWith('http') ? '_blank' : undefined} rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={socialIcons[social.icon] ?? socialIcons.rss} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-wrap {
    padding-bottom: var(--space-6);
  }

  .footer-shell {
    padding-top: 0;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-family: var(--font-ui);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
  }

  .footer-brand .meta {
    margin: var(--space-1) 0 0;
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.88rem;
  }

  .footer-links a:hover {
    color: var(--color-accent-strong);
  }

  .footer-socials {
    display: flex;
    gap: var(--space-3);
  }

  .footer-socials a {
    color: var(--color-text-muted);
    display: inline-flex;
  }

  .footer-socials a:hover {
    color: var(--color-accent-strong);
  }

  @media (max-width: 700px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
