---
import NotFoundPage from '../components/pages/NotFoundPage.astro';

// Build estático: um único /404.html é servido pelo host para qualquer
// caminho não encontrado, incluindo sob /en/*. Como não há uma rota real
// para inspecionar, detectamos o locale pretendido a partir do referrer
// (quando o navegador manda) e, na falta dele, olhamos o próprio path da
// tentativa de navegação no client-side — no build, o mais simples e
// confiável é olhar Astro.url.pathname (funciona no `astro dev`/preview e
// em hosts que repassam o path original, como o GitHub Pages faz).
const isEnglish = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';
const lang = isEnglish ? 'en' : 'pt-br';
---

<NotFoundPage lang={lang} />
