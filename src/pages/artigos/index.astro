---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import Pagination from '../../components/Pagination.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedArticles } from '../../lib/articles';
import { paginate } from '../../lib/paginate';
import { siteConfig } from '../../site.config';

const articles = await getPublishedArticles();
const page = paginate(articles, { page: 1, pageSize: siteConfig.articlesPerPage });
---

<BaseLayout title="Artigos" description={`Todos os artigos publicados em ${siteConfig.name}.`}>
  <div class="page-shell">
    <div class="surface surface-inner">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Artigos' }]} />
      <h1>Artigos</h1>
      <p class="meta articles-count">
        {articles.length} artigo{articles.length === 1 ? '' : 's'} publicado{articles.length === 1 ? '' : 's'}
      </p>

      <div class="article-list">
        {page.data.map((article) => <ArticleRow article={article} />)}
      </div>

      <Pagination page={page} firstPageHref="/artigos" pagePathPrefix="/artigos/pagina" />
    </div>
  </div>
</BaseLayout>

<style>
  .articles-count {
    margin-top: calc(var(--space-2) * -1);
    margin-bottom: var(--space-6);
  }

  .article-list {
    display: flex;
    flex-direction: column;
  }
</style>
